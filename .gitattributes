# Default: normalize text files
* text=auto

# Force LF for source files (Flutter/Dart/Web)
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.sh text eol=lf

# Keep Windows scripts CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf